        function accessCourse() {
            alert('🎉 কোর্স অ্যাক্সেস করা হচ্ছে! (DEMO মোডে এটি একটি নমুনা বার্তা)');
        }

        // Logout
        function logout() {
            showScreen('loginScreen');
            // Reset form values
            document.getElementById('phoneNumber').value = '';
            document.getElementById('adminCode').value = '';
            document.querySelectorAll('.otp-input').forEach(input => input.value = '');
            clearInterval(timerInterval);
        }

        // Show coin dashboard with animations
        function showCoinDashboard() {
            showScreen('coinDashboard');
            document.getElementById('coinDashboard').classList.add('page-scroll');
            
            // Start floating coins animation
            createFloatingCoins();
            
            // Animate coin counter
            animateCoinCounter();
        }

        // Create floating coins animation
        function createFloatingCoins() {
            for (let i = 0; i < 15; i++) {
                setTimeout(() => {
                    const coin = document.createElement('div');
                    coin.className = 'floating-coin';
                    coin.textContent = '🪙';
                    coin.style.left = Math.random() * 100 + 'vw';
                    coin.style.animationDelay = Math.random() * 2 + 's';
                    coin.style.animationDuration = (Math.random() * 2 + 3) + 's';
                    document.body.appendChild(coin);

                    setTimeout(() => {
                        coin.remove();
                    }, 5000);
                }, i * 200);
            }
        }

        // Animate coin counter
        function animateCoinCounter() {
            const coinAmount = document.getElementById('coinAmount');
            const walletBalance = document.getElementById('walletBalance');
            let currentAmount = 0;
            const targetAmount = 500;
            const increment = 25;
            
            const counterInterval = setInterval(() => {
                currentAmount += increment;
                if (currentAmount >= targetAmount) {
                    currentAmount = targetAmount;
                    clearInterval(counterInterval);
                }
                coinAmount.textContent = currentAmount;
                walletBalance.textContent = currentAmount;
            }, 100);
        }

        // Purchase course function
        function purchaseCourse(price) {
            const currentBalance = parseInt(document.getElementById('walletBalance').textContent);
            
            if (currentBalance >= price) {
                const newBalance = currentBalance - price;
                document.getElementById('walletBalance').textContent = newBalance;
                
                // Add purchase to transaction history
                const transactionHistory = document.querySelector('.transaction-history');
                const newTransaction = document.createElement('div');
                newTransaction.className = 'transaction-item';
                newTransaction.innerHTML = `
                    <span class="transaction-type">📚 কোর্স ক্রয়</span>
                    <span class="transaction-amount" style="color: #dc3545;">-${price} OCV</span>
                `;
                transactionHistory.appendChild(newTransaction);
                
                alert(`🎉 অভিনন্দন! কোর্সটি সফলভাবে কেনা হয়েছে! বাকি ব্যালেন্স: ${newBalance} OCV`);
                
                // Create celebration effect
                createCelebrationEffect();
            } else {
                alert('❌ দুঃখিত! পর্যাপ্ত OCV কয়েন নেই। আরো কয়েন অর্জন করুন।');
            }
        }

        // Create celebration effect
        function createCelebrationEffect() {
            for (let i = 0; i < 20; i++) {
                setTimeout(() => {
                    const celebration = document.createElement('div');
                    celebration.style.position = 'fixed';
                    celebration.style.left = Math.random() * 100 + 'vw';
                    celebration.style.top = '0px';
                    celebration.style.fontSize = '2rem';
                    celebration.style.zIndex = '1000';
                    celebration.style.pointerEvents = 'none';
                    celebration.textContent = ['🎉', '🎊', '✨', '🌟', '💫'][Math.floor(Math.random() * 5)];
                    celebration.style.animation = 'coinFloat 3s linear forwards';
                    document.body.appendChild(celebration);

                    setTimeout(() => {
                        celebration.remove();
                    }, 3000);
                }, i * 100);
            }
        }

        // Earn more coins function
        function earnMoreCoins() {
            const currentBalance = parseInt(document.getElementById('walletBalance').textContent);
            const bonusCoins = 100;
            const newBalance = currentBalance + bonusCoins;
            
            document.getElementById('walletBalance').textContent = newBalance;
            
            // Add bonus to transaction history
            const transactionHistory = document.querySelector('.transaction-history');
            const newTransaction = document.createElement('div');
            newTransaction.className = 'transaction-item';
            newTransaction.innerHTML = `
                <span class="transaction-type">🎯 দৈনিক বোনাস</span>
                <span class="transaction-amount">+${bonusCoins} OCV</span>
            `;
            transactionHistory.insertBefore(newTransaction, transactionHistory.children[2]);
            
            alert(`🎁 অভিনন্দন! আপনি ${bonusCoins} OCV কয়েন পেয়েছেন! মোট ব্যালেন্স: ${newBalance} OCV`);
            
            // Create bonus effect
            createFloatingCoins();
        }

        // Go back to admin panel
        function goBackToAdmin() {
            showScreen('adminDashboard');
        }

        // Open coin wallet from user panel
        function openCoinWallet() {
            showScreen('coinDashboard');
