                const user = sampleUsers.find(u => u.phone === phone);
                if (user) {
                    user.coins += parseInt(coinsToAdd);
                    loadUserList();
                    alert(`✅ সফলভাবে ${coinsToAdd} OCV কয়েন যোগ করা হয়েছে!\n\n${user.name} এর নতুন ব্যালেন্স: ${user.coins} OCV`);
                }
            }
        }

        // Calculate price for custom coins
        function calculatePrice() {
            const coins = document.getElementById('customCoins').value;
            const price = coins * 0.5;
            document.getElementById('totalPrice').textContent = price.toFixed(2);
        }

        // Purchase coins function
        function purchaseCoins(coins, price) {
            alert(`🎉 অভিনন্দন!\n\n${coins} OCV কয়েন সফলভাবে কেনা হয়েছে!\nমূল্য: ৳${price}\n\n(DEMO মোডে এটি একটি নমুনা লেনদেন)`);
            
            // Update statistics
            updatePurchaseStats(coins, price);
            
            // Create celebration effect
            createCelebrationEffect();
        }

        // Purchase custom coins
        function purchaseCustomCoins() {
            const coins = parseInt(document.getElementById('customCoins').value);
            if (coins && coins > 0) {
                const price = coins * 0.5;
                purchaseCoins(coins, price);
                document.getElementById('customCoins').value = '';
                document.getElementById('totalPrice').textContent = '০';
            } else {
                alert('অনুগ্রহ করে একটি বৈধ সংখ্যা লিখুন!');
            }
        }

        // Update purchase statistics
        function updatePurchaseStats(coins, price) {
            // Update today's sold coins
            const soldCoinsElement = document.querySelector('#coinSellSystem .stat-number');
            if (soldCoinsElement) {
                const currentSold = parseInt(soldCoinsElement.textContent.replace(/,/g, ''));
                const newSold = currentSold + coins;
                soldCoinsElement.textContent = newSold.toLocaleString();
            }
            
            // Update today's revenue
            const revenueElements = document.querySelectorAll('#coinSellSystem .stat-number');
            if (revenueElements[1]) {
                const currentRevenue = parseFloat(revenueElements[1].textContent.replace(/৳|,/g, ''));
                const newRevenue = currentRevenue + price;
                revenueElements[1].textContent = '৳' + newRevenue.toLocaleString();
            }
        }

        // Auto-fill demo values for testing
        setTimeout(() => {
            document.getElementById('phoneNumber').placeholder = "DEMO: যেকোনো নম্বর লিখুন";
        }, 1000);
    </script>
