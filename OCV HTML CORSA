            { phone: '+880 1823-456789', name: 'ফাতিমা খাতুন', coins: 1200, status: 'সক্রিয়', lastLogin: '১ দিন আগে' },
            { phone: '+880 1934-567890', name: 'মোহাম্মদ রহিম', coins: 300, status: 'নিষ্ক্রিয়', lastLogin: '৫ দিন আগে' },
            { phone: '+880 1645-678901', name: 'সালমা বেগম', coins: 950, status: 'সক্রিয়', lastLogin: '৩০ মিনিট আগে' },
