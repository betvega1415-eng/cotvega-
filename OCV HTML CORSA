        // Load user list
        function loadUserList() {
            const userList = document.getElementById('userList');
            userList.innerHTML = '';
            
            sampleUsers.forEach(user => {
                const userItem = document.createElement('div');
                userItem.className = 'user-item';
                userItem.innerHTML = `
                    <div class="user-info">
                        <div class="user-phone">${user.phone}</div>
                        <div class="user-details">${user.name} | ${user.status} | ${user.lastLogin}</div>
                    </div>
                    <div class="user-coins">
                        ${user.coins} OCV<br>
                        <small>৳${(user.coins * 0.5).toFixed(2)}</small>
                    </div>
                    <div class="user-actions">
                        <button class="action-btn" onclick="viewUserDetails('${user.phone}')">বিস্তারিত</button>
