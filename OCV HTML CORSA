                    </div>
                `;
                userList.appendChild(userItem);
            });
        }

        // Search user function
        function searchUser() {
            const searchTerm = document.getElementById('searchPhone').value.toLowerCase();
            const userItems = document.querySelectorAll('.user-item');
            
            userItems.forEach(item => {
                const phoneText = item.querySelector('.user-phone').textContent.toLowerCase();
                const nameText = item.querySelector('.user-details').textContent.toLowerCase();
                
                if (phoneText.includes(searchTerm) || nameText.includes(searchTerm)) {
                    item.style.display = 'flex';
                    if (searchTerm.length > 0) {
                        item.classList.add('search-highlight');
                    } else {
                        item.classList.remove('search-highlight');
                    }
                } else {
                    item.style.display = 'none';
                    item.classList.remove('search-highlight');
                }
            });
        }

        // View user details
        function viewUserDetails(phone) {
            const user = sampleUsers.find(u => u.phone === phone);
            if (user) {
                alert(`📱 ব্যবহারকারীর বিস্তারিত:\n\nফোন: ${user.phone}\nনাম: ${user.name}\nকয়েন: ${user.coins} OCV\nমূল্য: ৳${(user.coins * 0.5).toFixed(2)}\nস্ট্যাটাস: ${user.status}\nশেষ লগইন: ${user.lastLogin}`);
